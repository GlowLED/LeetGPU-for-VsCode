{
  "name": "leetgpu",
  "displayName": "LeetGPU for VS Code (Unofficial)",
  "description": "Solve LeetGPU challenges from VS Code with native files, remote execution, submissions, and leaderboards.",
  "version": "0.4.4",
  "publisher": "glowled",
  "icon": "media/leetgpu.png",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/GlowLED/LeetGPU-for-VsCode.git"
  },
  "homepage": "https://github.com/GlowLED/LeetGPU-for-VsCode#readme",
  "bugs": {
    "url": "https://github.com/GlowLED/LeetGPU-for-VsCode/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "gpu",
    "cuda",
    "triton",
    "pytorch",
    "jax",
    "mojo"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onView:leetgpu.challenges",
    "onView:leetgpu.console",
    "onCommand:leetgpu.openChallenge",
    "onCommand:leetgpu.run",
    "onCommand:leetgpu.submit",
    "onCommand:leetgpu.rebuildLanguageSupport",
    "workspaceContains:**/.leetgpu.json"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "media",
    "syntaxes",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetgpu",
          "title": "LeetGPU",
          "icon": "media/leetgpu-view.png"
        }
      ],
      "panel": [
        {
          "id": "leetgpuPanel",
          "title": "LeetGPU",
          "icon": "media/leetgpu-view.png"
        }
      ]
    },
    "views": {
      "leetgpu": [
        {
          "id": "leetgpu.challenges",
          "name": "Challenges"
        }
      ],
      "leetgpuPanel": [
        {
          "type": "webview",
          "id": "leetgpu.console",
          "name": "Console"
        }
      ]
    },
    "commands": [
      { "command": "leetgpu.signIn", "title": "LeetGPU: Sign In" },
      { "command": "leetgpu.importSessionFromClipboard", "title": "LeetGPU: Import Session JSON from Clipboard" },
      { "command": "leetgpu.importSession", "title": "LeetGPU: Import Session Manually" },
      { "command": "leetgpu.disconnect", "title": "LeetGPU: Disconnect" },
      { "command": "leetgpu.refreshChallenges", "title": "LeetGPU: Reload Challenge List", "icon": "$(refresh)" },
      { "command": "leetgpu.findChallenge", "title": "LeetGPU: Find Challenge", "icon": "$(search)" },
      { "command": "leetgpu.openChallenge", "title": "LeetGPU: Open Challenge" },
      { "command": "leetgpu.run", "title": "LeetGPU: Run", "icon": "$(play)" },
      { "command": "leetgpu.submit", "title": "LeetGPU: Submit", "icon": "$(cloud-upload)" },
      { "command": "leetgpu.cancel", "title": "LeetGPU: Cancel Active Run", "icon": "$(debug-stop)" },
      { "command": "leetgpu.selectAccelerator", "title": "LeetGPU: Select Accelerator", "icon": "$(server-environment)" },
      { "command": "leetgpu.showAssembly", "title": "LeetGPU: View PTX / SASS", "icon": "$(code)" },
      { "command": "leetgpu.showSubmissions", "title": "LeetGPU: Show Submissions" },
      { "command": "leetgpu.showSolutions", "title": "LeetGPU: Show Solutions" },
      { "command": "leetgpu.showLeaderboard", "title": "LeetGPU: Show Challenge Leaderboard" },
      { "command": "leetgpu.showGlobalLeaderboard", "title": "LeetGPU: Show Global Leaderboard" },
      { "command": "leetgpu.resetSolution", "title": "LeetGPU: Reset Solution to Latest Starter" },
      { "command": "leetgpu.rebuildLanguageSupport", "title": "LeetGPU: Rebuild Language Support" }
    ],
    "menus": {
      "view/title": [
        { "command": "leetgpu.findChallenge", "when": "view == leetgpu.challenges", "group": "navigation@1" },
        { "command": "leetgpu.refreshChallenges", "when": "view == leetgpu.challenges", "group": "navigation@2" }
      ],
      "editor/title": [
        { "command": "leetgpu.run", "when": "leetgpu.activeSolution && !leetgpu.running", "group": "navigation@1" },
        { "command": "leetgpu.submit", "when": "leetgpu.activeSolution && !leetgpu.running", "group": "navigation@2" },
        { "command": "leetgpu.showAssembly", "when": "leetgpu.activeSolution && leetgpu.activeLanguage == cuda && !leetgpu.running", "group": "navigation@3" },
        { "command": "leetgpu.cancel", "when": "leetgpu.activeSolution && leetgpu.running", "group": "navigation@1" }
      ]
    },
    "keybindings": [
      { "command": "leetgpu.run", "key": "ctrl+'", "mac": "cmd+'", "when": "editorTextFocus && leetgpu.activeSolution && !leetgpu.running" },
      { "command": "leetgpu.submit", "key": "ctrl+enter", "mac": "cmd+enter", "when": "editorTextFocus && leetgpu.activeSolution && !leetgpu.running" }
    ],
    "languages": [
      { "id": "leetgpu-ptx", "aliases": ["PTX", "ptx"], "extensions": [".ptx"] },
      { "id": "leetgpu-sass", "aliases": ["NVIDIA SASS", "sass-asm"], "extensions": [".sassasm"] }
    ],
    "grammars": [
      { "language": "leetgpu-ptx", "scopeName": "source.leetgpu.ptx", "path": "./syntaxes/ptx.tmLanguage.json" },
      { "language": "leetgpu-sass", "scopeName": "source.leetgpu.sass", "path": "./syntaxes/sass.tmLanguage.json" }
    ],
    "configuration": {
      "title": "LeetGPU",
      "properties": {
        "leetgpu.solutionDirectory": {
          "type": "string",
          "default": "leetgpu",
          "description": "Workspace-relative directory used for challenge solutions."
        },
        "leetgpu.defaultAccelerator": {
          "type": "string",
          "default": "T4",
          "description": "Preferred LeetGPU accelerator. Falls back based on language, GPU/TPU compatibility, and account access."
        },
        "leetgpu.submissionVisibility": {
          "type": "string",
          "enum": ["private", "public"],
          "default": "private",
          "description": "Whether new submissions are public on LeetGPU."
        },
        "leetgpu.languageSupport.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Generate dependency-free CUDA/Python/Mojo analysis models and provide LeetGPU completion, hover, and signature help."
        },
        "leetgpu.languageSupport.suggestExtensions": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time suggestion for compatible C/C++, Python/Pylance, or Mojo language extensions."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run check && npm run test && npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "sanitize-html": "^2.17.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
